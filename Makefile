# ==========================================
# Compiler Settings
# ==========================================
CC = gcc
# -Wall -Wextra: 警告を厳しく出す（バグ防止）
# -O3: 最適化レベル最大（モンゴメリ乗算の速度を出すため）
# -I./include: ヘッダーファイルの場所を指定
CFLAGS = -Wall -Wextra -O3 -I./include

# ==========================================
# Files
# ==========================================
# 成果物の名前
TARGET = test_runner

# ソースファイル（srcフォルダの中身全部 + テストコード）
SRCS = $(wildcard src/*.c) tests/main.c

# オブジェクトファイル（.c を .o に置換したリストを自動生成）
OBJS = $(SRCS:.c=.o)

# ==========================================
# Build Rules
# ==========================================

# 'make' とだけ打った時に実行されるターゲット
all: $(TARGET)

# リンク（最終的な実行ファイルを作る）
$(TARGET): $(OBJS)
	$(CC) $(CFLAGS) -o $@ $^

# コンパイル（各 .c から .o を作る）
# %.o: %.c は「すべての.cファイルに対して」という意味
%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

# ==========================================
# Utilities
# ==========================================

# 生成ファイルを削除して綺麗にする
clean:
	rm -f $(OBJS) $(TARGET)

# テストを実行するショートカット
run: $(TARGET)
	./$(TARGET)

.PHONY: all clean run